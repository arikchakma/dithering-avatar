{
  "name": "dithering-avatar",
  "version": "0.1.1",
  "description": "Turn names into dithered SVG avatars with zero dependencies",
  "keywords": [
    "avatar",
    "dither",
    "bayer",
    "svg",
    "react",
    "generative"
  ],
  "license": "MIT",
  "author": "Arik Chakma",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsdown && node --test test/*.test.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "release": "bumpp"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bumpp": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.13.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arikchakma/dithering-avatar.git"
  },
  "homepage": "https://github.com/arikchakma/dithering-avatar#readme"
}
